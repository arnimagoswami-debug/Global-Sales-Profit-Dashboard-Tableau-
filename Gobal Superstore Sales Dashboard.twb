      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.069msv91wpfeyz1fdlx5k1n979eq].[cnt:Quantity:qk]&quot;' value='Total Orders' />
          <alias key='&quot;[federated.069msv91wpfeyz1fdlx5k1n979eq].[sum:Profit:qk]&quot;' value='Total Profit' />
          <alias key='&quot;[federated.069msv91wpfeyz1fdlx5k1n979eq].[sum:Sales:qk]&quot;' value='Total Sales' />
          <alias key='&quot;[federated.069msv91wpfeyz1fdlx5k1n979eq].[usr:Calculation_236720511073693697:qk]&quot;' value=' Avg Order Value' />
          <alias key='&quot;[federated.069msv91wpfeyz1fdlx5k1n979eq].[usr:Calculation_236720511076417542:qk]&quot;' value=' Return Rate %' />
        </aliases>
      </column>
      <column caption='4. Avg Order Value' datatype='real' name='[Calculation_236720511073693697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD([Order ID])' />
      </column>
      <column caption='1. Return Flag' datatype='integer' name='[Calculation_236720511075897347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF IFNULL([Returned],&quot;No&quot;) = &quot;Yes&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='2. Profit Margin' datatype='real' name='[Calculation_236720511076016132]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sales] &lt;&gt; 0 THEN [Profit]/[Sales] ELSE 0 END' />
      </column>
      <column caption='3. Shipping Days' datatype='integer' name='[Calculation_236720511076204549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Order Date], [Ship Date])' />
      </column>
      <column caption='5. Return Rate %' datatype='real' name='[Calculation_236720511076417542]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_236720511075897347]) / COUNTD([Order ID]) * 100' />
      </column>
      <column caption='6. Profit (Returned)' datatype='real' name='[Calculation_236720511076560903]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_236720511075897347]=1 THEN [Profit] ELSE 0 END)' />
      </column>
      <column caption='7. Profit (Non-Returned)' datatype='real' name='[Calculation_236720511076667400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_236720511075897347]=0 THEN [Profit] ELSE 0 END)' />
      </column>
      <column caption='“Profit % by Category”' datatype='real' name='[Calculation_915919635233841153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM({FIXED : SUM([Profit])})' />
      </column>
